{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode-go/gpt-6-luna",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "plugin": ["@razroo/opencode-model-fallback@0.3.2"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": { "*": "ask" },
    "task": { "general": "deny" }
  },
  "agent": {
    "explore": {
      "model": "opencode-go/claude-haiku-5-5"
    },
    "plan": {
      "model": "opencode-go/gemini-4-argon"
    },
    "postgres-dba": {
      "model": "opencode-go/minimax-m3.1-flash"
    },
    "build": {
      "mode": "all",
      "model": "opencode-go/deepseek-v4.1-flash",
      "fallback_models": [
        "opencode-go/minimax-m3.1-flash",
        "opencode-go/glm-5.3-flash"
      ]
    },
    "change-reviewer": {
      "model": "opencode-go/qwen3.8-max",
      "fallback_models": [
        "opencode-go/glm-5.2"
      ]
    },
    "security-reviewer": {
      "model": "opencode-go/minimax-m3.1-flash"
    }
  },
  "mcp": {
    "shadcn-ui": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "enabled": false
    }
  }
}
