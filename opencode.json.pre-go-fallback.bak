{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v3",
  "small_model": "opencode/nemotron-3.5",
  "agent": {
    "plan": { "model": "opencode/deepseek-v3" },
    "build": { "model": "opencode/deepseek-v3", "temperature": 0.2 },
    "explore": { "model": "opencode/nemotron-3.5" }
  },
  "permission": {
    "read": {
      "*": "allow",
      "C:\\Users\\LEO\\.config\\opencode\\**": "allow",
      "*.env": "deny",
      "*.env.*": "deny"
    }
  },
  "mcp": {
    "shadcn-ui": {
      "type": "local",
      "command": ["npx", "-y", "shadcn-ui-mcp-server"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp"],
      "enabled": true
    }
  }
}