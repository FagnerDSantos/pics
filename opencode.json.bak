{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "model": "opencode-go/gpt-6-luna",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "opencode-go/gpt-6-luna",
      "prompt": "{file:./prompts/orchestrator.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "plan": "allow",
          "postgres-dba": "allow",
          "build": "allow",
          "change-reviewer": "allow",
          "security-reviewer": "allow"
        }
      }
    },
    "plan": {
      "model": "opencode-go/kimi-k3.1-pro",
      "permission": { "edit": "deny" }
    },
    "build": {
      "model": "opencode-go/kimi-k2.7-code",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git commit*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "Remove-Item*": "ask"
        }
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash",
      "permission": { "edit": "deny" }
    }
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "skill": { "*": "ask" },
    "task": { "general": "deny" }
  },
  "mcp": {
    "shadcn-ui": {
      "type": "local",
      "command": ["npx", "-y", "shadcn@latest", "mcp"],
      "enabled": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "enabled": false
    }
  }
}
